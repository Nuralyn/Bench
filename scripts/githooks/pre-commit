#!/bin/sh
# Compatibility shim. The ledger commit guard lives at hooks/pre-commit, where
# it ships inside the Bench wheel for `bench install` to copy into governed
# projects. Clones that enabled the guard with
#   git config core.hooksPath scripts/githooks
# keep working through this file. Git runs hooks from the repository root.
exec "$(dirname "$0")/../../hooks/pre-commit" "$@"
