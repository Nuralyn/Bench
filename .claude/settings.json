{
  "env": {
    "BENCH_PROVIDER": "claude_code",
    "BENCH_CLAUDE_TIMEOUT": "300"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/pre-tool-use.py"
          }
        ]
      }
    ]
  }
}
