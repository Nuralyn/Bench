{
  "env": {
    "BENCH_PROVIDER": "claude_code"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"/absolute/path/to/python\" \"/absolute/path/to/bench/hooks/pre-tool-use.py\""
          }
        ]
      }
    ]
  }
}
